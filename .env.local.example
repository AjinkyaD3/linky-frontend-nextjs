# Base URL of the Spring Boot API the browser talks to directly.
# Also used to build the CSP connect-src/img-src allowlist at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical public origin of this site. Used for metadataBase, canonical URLs,
# Open Graph URLs, robots.txt and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:4300
